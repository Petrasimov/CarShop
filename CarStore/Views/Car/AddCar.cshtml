@model CarStore.Data.ViewModels.AddCarViewModel
<div class="container">
<form asp-action="AddCar" asp-controller="Car" method="post" enctype="multipart/form-data">
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="@Model.Car.Name">Название</label>
                <input asp-for="@Model.Car.Name" type="text" class="form-control" />
        </div>
        <div class="form-group col-md-6">
                <label asp-for="@Model.Car.ShortDescription">Краткое описание</label>
                <input asp-for="@Model.Car.ShortDescription" type="text" class="form-control" />
        </div>
    </div>
    <div class="form-group col-md-12">
            <label asp-for="@Model.Car.LongDescription">Полное описание</label>
            <textarea asp-for="@Model.Car.LongDescription" rows="3" type="text" class="form-control"></textarea>
    </div>
    <div class="form-row">
        <div class="form-group col-md-3">
                <label asp-for="@Model.Car.Price">Цена</label>
                <input asp-for="@Model.Car.Price" type="number" class="form-control" />
        </div>
        <div class="form-group col-md-3">
            <label asp-for="@Model.Car.CategoryId">Категория автомобиля</label>
            <select asp-for="@Model.Car.CategoryId" class="form-select">
                 <option selected>Выберите категорию</option>
                @foreach (var category in @Model.Categories)
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <div class="form-check col-md-5">
                <label asp-for="@Model.Car.IsFavourite">
                    <input asp-for="@Model.Car.IsFavourite" class="form-check-input" type="checkbox" />
                Добавить на главной странице
            </label>
        </div>
        <div class="form-check col-md-5">
                <label asp-for="@Model.Car.Available">
                    <input asp-for="@Model.Car.Available" class="form-check-input" type="checkbox" />
                Товар доступен для заказа
            </label>
        </div>
    </div>
    <div class="form-group">
            <label asp-for="@Model.Car.Img">Картинка</label>
            <input asp-for="@Model.Car.Img" type="file" name="uploadedFile" /> <br>
    </div>
    <button type="submit" class="btn btn-primary">Добавить</button>
</form>
</div>