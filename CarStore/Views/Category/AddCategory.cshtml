@model DatabaseService.Models.Category
<div class="container">
<form asp-action="AddCategory" asp-controller="Category" method="post" enctype="multipart/form-data">
    <div class="form-row">
        <div class="form-group">
            <label asp-for="CategoryName">Название</label>
                <input asp-for="CategoryName" type="text" class="form-control" />
        </div>
    </div>
    <div class="form-group col-md-12">
            <label asp-for="Description">Описание</label>
            <textarea asp-for="Description" rows="3" type="text" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Добавить</button>
</form>
</div>